@{
    ViewData["Title"] = "Register Page";
}
 <link rel="stylesheet" href="~/css/Style.css" />

<center>
<div class="data">
<h1>Register here</h1>
    <table>
     <tr>
    <td>Full Name:</td>
    <td><input type="text" name="quantity" placeholder="Full Name"/></td>
    </tr>

    <tr>
    <td>UserName:</td>
    <td><input type="text" name="user" placeholder="UserName"/></td>
    </tr>

     <tr>
    <td>Password:</td>
    <td><input type="password" name="pass" placeholder="Password"/></td>
    </tr>

     <tr>
    <td>Contact:</td>
    <td><input type="text" name="description" placeholder="Contact Number"/></td>
    </tr>

     <tr>
    <td>Email:</td>
    <td><input type="text" name="unitprice" placeholder="Email address"/></td>
    </tr>

     <tr>
    <td></td>
    <td><input type="button" name="btn" value=" Register "/></td>
    </tr>

    </table>
    </div>
</center>
