@using Model.Flower;
@using Model.Cart
@{
    ViewData["Title"] = "Shopping Cart Page";
}

<div class="text-center">
    <h1>Cart Items...</h1>
    <hr />
    @{
        var cartitems = ViewData["CartItems"] as Cart;
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayName("Flower ID")</th>
                    <th>@Html.DisplayName("Flower Name")</th>
                    <th>@Html.DisplayName("Quantity")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cartitems.Items)
                {
                    <tr>
                        <td>@Html.DisplayFor(flowerData => item.FlowerId)</td>
                        <td>@Html.DisplayFor(flowerData => item.FlowerName)</td>
                        <td>@Html.DisplayFor(flowerData => item.Quantity)</td>
                        <td><a href="/ShoppingCart/index/?id">remove</a></td>
                    </tr>
                }

            </tbody>
        </table>


