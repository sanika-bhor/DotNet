@using ShoppingCart;
@model Item;

@{
    ViewBag.Title = "cart update Page";
}
 <link rel="stylesheet" href="~/css/Style.css" />


<div class="data">
<h1>Update Product</h1>

    <form action="/ShoppingCart/insert" method="post">

        <table>
            <tr>
                <td>Product id:</td>
                <td><input type="text" name="id" placeholder="Product id" value="@Model.product.ProductId" /></td>
            </tr>

            <tr>
                <td>Customer Id :</td>
                <td><input type="text" name="customerid" placeholder="Customer Id" value="@Model.CustomerId"/></td>
            </tr>

            <tr>
                <td>Name:</td>
                <td><input type="text" name="title" placeholder="Product Name" value="@Model.product.ProductName" /></td>
            </tr>


            <tr>
                <td>UnitPrice:</td>
                <td><input type="text" name="unitprice" placeholder="Product unitprice" value="@Model.product.UnitPrice" /></td>
            </tr>

            <tr>
                <td>Quantity:</td>
                <td><input type="text" name="quantity" placeholder="Product quantity"value="@Model.Quantity" /></td>
            </tr>

            <tr>
                <td></td>
                <td><input type="submit" class="submitButton" name="btn" value=" Update " /></td>
            </tr>

        </table>
    </form>
</div>
