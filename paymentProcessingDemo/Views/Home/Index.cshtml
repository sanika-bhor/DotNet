@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayName("Id")</th>
                <th>@Html.DisplayName("OrderId")</th>
                <th>@Html.DisplayName("Amount")</th>
                <th>@Html.DisplayName("PaymentDate")</th>
                <th>@Html.DisplayName("PaymentMode")</th>
                <th>@Html.DisplayName("Action")</th>
            </tr>
        </thead>
        <tbody>
            @{
                List<Payment>payments=ViewData["AllPayment"] as List<Payment>;
                    foreach(Payment payment in payments)
                    {
                        <tr>
                            <td>@Html.DisplayFor(model => payment.Id)</td>
                            <td>@Html.DisplayFor(model => payment.OrderId)</td>
                            <td>@Html.DisplayFor(model => payment.Amount)</td>
                            <td>@Html.DisplayFor(model => payment.PaymentDate)</td>
                            <td>@Html.DisplayFor(model => payment.PaymentMode)</td>
                        <td><a href="/home/GetById/@payment.Id">Details</a></td>
                        </tr>
                    }
            }
        </tbody>
    </table>
</div>
