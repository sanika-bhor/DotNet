@using System.Collections.Generic;
@using ShoppingCart;
@using BLL;
@using Catelog;
@{
    ViewData["Title"] = "Cart Home Page";
}
<link rel="stylesheet" href="~/css/Style.css" />
<style>
.cartItem
{
    width:200px;
}
</style>
<div class="main">
    <h1 >Shopping cart</h1>

    @{
       
        List<Item> items = (List<Item>)ViewData["allItems"];
        <div class="container">
            @foreach (Item item in items)
            {
                 var product = item.product;
                <div class="cart cartItem">
                    <h2>@product.ProductName</h2>
                    <p><b>ProductId:</b> @product.ProductId</p>
                    <p><b>CustomerId:</b> @item.CustomerId</p>
                    <p><b>Title: </b>@product.ProductName</p>
                    <p><b>Price:</b> @product.UnitPrice</p>
                    <p><b>Quantity:</b> @item.Quantity</p>
                    <a href="/ShoppingCart/delete/@item.CustomerId"><button value="details">Delete</button></a>
                </div>
            }
        </div>


    }
    <hr>
    <hr>
  

</div>
