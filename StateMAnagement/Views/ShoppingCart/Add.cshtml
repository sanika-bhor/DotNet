@using Model.Flower;
@{
    ViewData["Title"] = "Shopping Cart Page";
}

<div class="text-center">
    @{
       var flower = ViewData["FlowerById"] as Flower;
        <form method="post" action="/ShoppingCart/Add">
            <table>
                <tr>
                    <td><label>FLower ID</label></td>
                    <td> <input type="text" name="flowerId" value="@flower.FlowerId" /></td>
                </tr>
                <tr>
                    <td><label>FLower Name</label></td>
                    <td> <input type="text" name="flowerName"a value="@flower.FlowerName" /></td>
                </tr>
                <tr>
                    <td><label>Flower Quantity</label></td>
                    <td> <input type="text" name="quantity"value="@flower.Quantity" /></td>
                </tr>

                <tr>
                    <td></td>
                    <td> <input type="submit" value="Add To cart" /></td>
                </tr>
            </table>
            </form>
    }
</div>
