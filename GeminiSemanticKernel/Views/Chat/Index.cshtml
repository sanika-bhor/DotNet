<form asp-action="Ask" method="post">

    <textarea name="prompt"
              rows="5"
              class="form-control">
    </textarea>

    <br />

    <button class="btn btn-primary">
        Ask
    </button>

</form>

@if (ViewBag.Answer != null)
{
    <div class="alert alert-success mt-3">
        @ViewBag.Answer
    </div>
}