@using Model.Flower;
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1>Todays Products for sale...</h1>
    <hr />
    @{
        List<Flower> flowers=ViewData["allflowers"] as List<Flower>;
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayName("Flower ID")</th>
                    <th>@Html.DisplayName("Flower Name")</th>
                    <th>@Html.DisplayName("Discription")</th>
                    <th>@Html.DisplayName("Unit Price")</th>
                    <th>@Html.DisplayName("Quantity")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Flower flower in flowers)
                {
                <tr>
                   
                        <td>@Html.DisplayFor(flowerData=>flower.FlowerId)</td>
                        <td>@Html.DisplayFor(flowerData=>flower.FlowerName)</td>
                        <td>@Html.DisplayFor(flowerData=>flower.Discription)</td>
                        <td>@Html.DisplayFor(flowerData=>flower.UnitPrice)</td>
                        <td>@Html.DisplayFor(flowerData=>flower.Quantity)</td>
                        <td><a href="/ShoppingCart/Add/@flower.FlowerId">Add To Cart</a></td>
                </tr>
                }

            </tbody>
        </table>
    }
</div>
    
