@{
    ViewData["Title"] = "Product update Page";
}
 <link rel="stylesheet" href="~/css/Style.css" />


<div class="data">
<h1>Update Product</h1>
    <table>
    <tr>
    <td>Product id:</td>
    <td><input type="text" name="pid" placeholder="Product existing id"/></td>
    </tr>

     <tr>
    <td>Name:</td>
    <td><input type="text" name="name" placeholder="Product Name"/></td>
    </tr>

     <tr>
    <td>Description:</td>
    <td><input type="text" name="description" placeholder="Product Description"/></td>
    </tr>

     <tr>
    <td>UnitPrice:</td>
    <td><input type="text" name="unitprice" placeholder="Product unitprice"/></td>
    </tr>

     <tr>
    <td>Quantity:</td>
    <td><input type="text" name="quantity" placeholder="Product quantity"/></td>
    </tr>

     <tr>
    <td></td>
    <td><input type="button" name="btn" value=" Update "/></td>
    </tr>

    </table>
</div>
