@using core.Model.Flower;
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
   @{
        List<Flower> AllFlowers = (List<Flower>)ViewData["allFlowers"];
    <table border="2">
        <tr>
                <th style="padding: 20px;">Flower Id</th>
                <th style="padding: 20px;">Flower Name</th>
                <th style="padding: 20px;">Discription</th>
                <th style="padding: 20px;">Unit Price</th>
                <th style="padding: 20px;">Quantity</th>
        </tr>
        @foreach(Flower flower in AllFlowers)
        {
            <tr>
                    <td style="padding: 20px;">@flower.FlowerId</td>
                    <td style="padding: 20px;">@flower.FlowerName</td>
                    <td style="padding: 20px;">@flower.Discription</td>
                    <td style="padding: 20px;">@flower.UnitPrice</td>
                    <td style="padding: 20px;">@flower.Quantity</td>
            </tr>
        }
       
    </table>
    }
</div>
